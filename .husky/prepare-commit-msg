#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

# Detect if we're on Windows
if [ "$OS" = "Windows_NT" ] || [ "$(uname -s | cut -c1-5)" = "MINGW" ] || [ "$(uname -s | cut -c1-4)" = "MSYS" ]; then
  # Windows: run without TTY redirection
  npx cz --hook || true
else
  # Unix/Linux/macOS: use TTY if available
  if [ -e /dev/tty ]; then
    exec < /dev/tty && npx cz --hook || true
  else
    npx cz --hook || true
  fi
fi
