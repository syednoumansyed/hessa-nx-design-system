{
  "name": "nx-fe",
  "version": "1.19.1+24",
  "author": "NCLE",
  "homepage": "https://ionicframework.com/",
  "description": "nx LMS front-end project",
  "scripts": {
    "ng": "ng",
    "start": "npx ionic serve",
    "start:admin": "cd ./admin-panel  && npx ionic serve --port=4200",
    "start:network": "npx ionic serve --host 0.0.0.0",
    "mock": "npx ionic serve --configuration mock",
    "start:ios": "ionic capacitor run ios -l --external",
    "watch": "ng build --watch --configuration development",
    "start:android": "ionic capacitor run android -l --external",
    "build": "ionic build",
    "build:admin": "cd ./admin-panel && ionic build",
    "build:admin:development": "cd ./admin-panel && ionic build --configuration development-deploy",
    "build:admin:staging": "cd ./admin-panel && ionic build --configuration staging",
    "build:admin:production": "cd ./admin-panel && ionic build --configuration production",
    "build:web:development": "ionic build --configuration development-deploy",
    "build:web:staging": "ionic build --configuration staging",
    "build:web:production": "ionic build --configuration production",
    "build:android:development": "ionic capacitor build android --configuration development-deploy --no-open",
    "build:android:staging": "ionic capacitor build android --configuration staging --no-open",
    "build:android:production": "ionic capacitor build android --configuration production --no-open",
    "build:ios:development": "ionic capacitor build ios --configuration development-deploy --no-open",
    "build:ios:staging": "ionic capacitor build ios --configuration staging --no-open",
    "build:ios:production": "ionic capacitor build ios --configuration production --no-open",
    "build:capgo:development": "ionic build --configuration development && npx @capgo/cli bundle upload dev.ncle.hessa.app --channel=development",
    "build:capgo:staging": "ionic build --configuration staging && npx @capgo/cli bundle upload stg.ncle.hessa.app --channel=staging",
    "build:capgo:production": "ionic build --configuration production && npx @capgo/cli bundle upload sa.com.hessa.app --channel=production",
    "push:capgo:development": "npx @capgo/cli bundle upload dev.ncle.hessa.app --channel=development",
    "push:capgo:staging": "npx @capgo/cli bundle upload stg.ncle.hessa.app --channel=staging",
    "push:capgo:production": "npx @capgo/cli bundle upload sa.com.hessa.app --channel=production",
    "unit-tests": "ng test --code-coverage",
    "test": "npx cypress open",
    "test:ci": "npx cypress run headless",
    "ng:test": "ng test --watch --code-coverage",
    "ng:test:ci": "ng test --watch=false --code-coverage --browsers=ChromeHeadlessCI",
    "lint": "ng lint",
    "build:sentry": "ionic build && npm run sentry:sourcemaps",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org ncle-edu --project hessa-fe ./www/browser && sentry-cli sourcemaps upload --org ncle-edu --project hessa-fe ./www/browser",
    "prepare": "husky install",
    "cm": "cz",
    "storybook": "ng run app:storybook",
    "build-storybook": "ng run app:build-storybook",
    "storybook:audit": "ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/audit-stories-coverage.ts",
    "storybook:agent-manifest": "node tools/storybook-agent/generate-agent-manifest.js",
    "storybook:agent-manifest:static": "node tools/storybook-agent/generate-agent-manifest.js --source storybook-static/index.json --out storybook-static/agent-manifest",
    "storybook:agent-validate": "node tools/storybook-agent/validate-agent-workflow.js",
    "build-storybook:agent": "npm run build-storybook && npm run storybook:agent-manifest:static",
    "post-version": "ts-node scripts/version-creator.ts"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.2.14",
    "@angular/cdk": "^19.2.18",
